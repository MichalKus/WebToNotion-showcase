# WebToNotion Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=WebToNotion
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Notion API Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_VERSION=2025-09-03

# Logfire Configuration (for monitoring)
LOGFIRE_TOKEN=your_logfire_token_here
LOGFIRE_PROJECT_NAME=webtonotion

# Web Scraping Configuration
USER_AGENT=WebToNotion/0.1.0 (https://github.com/MichalKus/WebToNotion)
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# AI
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=base

# Video Processing Configuration
CACHE_DIR=./cache
MAX_VIDEO_DURATION=3600
ENABLE_CACHING=true
MAX_CONCURRENT_DOWNLOADS=3
AUDIO_QUALITY=best
CHUNK_SIZE=1024
CACHE_EXPIRATION=86400
MAX_AUDIO_SIZE=100MB
TEMP_DIR=/tmp/webtonotion
CLEANUP_TEMP_FILES=true
MAX_FILE_SIZE=500MB
MAX_CONCURRENT_JOBS=5
VERBOSE_LOGGING=false