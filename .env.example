# WebToNotion Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=WebToNotion
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Notion API Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_VERSION=2025-09-03

# Logfire Configuration (for monitoring)
LOGFIRE_TOKEN=your_logfire_token_here
LOGFIRE_PROJECT_NAME=webtonotion

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
MAX_RETRIES=3

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
API_KEY=your_api_access_key_here

# AI
WHISPER_MODEL=whisper-large-v3
WHISPER_API_KEY=your_whisper_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Agentic Orchestrator (chat surface)
# Max model requests across one chat turn (orchestrator + sub-agent runs) -
# a runaway-loop bound, not a cost bound
AGENT_MAX_REQUESTS=60
# Max total tokens (input+output) across one chat turn - the real cost guard.
# Exceeding it returns HTTP 429 and the turn is not persisted. 0 disables it
AGENT_MAX_TOTAL_TOKENS=500000
# Reasoning effort: off | minimal | low | medium | high | xhigh
# Needs a reasoning-capable model; higher levels cost more reasoning tokens
AGENT_THINKING_LEVEL=medium
# SQLite file holding chat sessions and message history
SESSION_DB_PATH=./cache/sessions.db
# Retention (seconds) for the 'metadata' cache artifact holding the transcript
# and cached summaries. Disk sweep, not a correctness bound. 0 = never expire
TRANSCRIPT_TTL=2592000
# Characters of transcript surfaced in a TranscriptRef preview
TRANSCRIPT_PREVIEW_CHARS=500
# Transcript length above which summarization switches to map-reduce
SUMMARY_MAP_REDUCE_THRESHOLD_CHARS=120000
# Window size (characters) for each map step of a map-reduce summary
SUMMARY_MAP_REDUCE_WINDOW_CHARS=20000
# TTL for the provider prompt-cache breakpoint after the transcript: 5m | 1h
PROMPT_CACHE_TTL=1h

# Video Processing Configuration
MAX_CONTENT_LENGTH=104857600
REQUEST_TIMEOUT=300
CACHE_DIR=./cache
MAX_VIDEO_DURATION=3600
ENABLE_CACHING=true
AUDIO_QUALITY=best
CACHE_EXPIRATION=86400
TEMP_DIR=/tmp/webtonotion
CLEANUP_TEMP_FILES=true
MAX_FILE_SIZE=500MB
VERBOSE_LOGGING=false
